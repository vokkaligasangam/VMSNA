---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Welfare inbox"
  lead="Education, medical, employment and other assistance requests from the community. These are confidential — they are visible only to administrators and are never shown to other members."
>
  <div class="bar">
    <label class="toggle">
      <input type="checkbox" data-show-handled />
      <span>Show handled requests</span>
    </label>
    <p class="counts" id="counts" role="status" aria-live="polite"></p>
  </div>

  <p class="status" data-inbox-status hidden></p>
  <div id="inbox" class="inbox"></div>
</AdminLayout>

<script>
  import { mountInbox } from '../../lib/inboxView';

  const inbox = mountInbox({
    collection: 'helpRequests',
    mount: document.getElementById('inbox')!,
    statusBox: document.querySelector<HTMLElement>('[data-inbox-status]')!,
    titleField: 'requestType',
    subtitleFields: ['name', 'urgency'],
    primary: ['name', 'email', 'requestType', 'urgency', 'program', 'situation', 'field', 'experience', 'service', 'statement', 'summary', 'details'],
    emptyMessage: 'No assistance requests have been received.',
  });

  document.addEventListener('inbox:counts', (event) => {
    const { open, total } = (event as CustomEvent).detail;
    const el = document.getElementById('counts');
    if (el) el.textContent = `${open} open · ${total} total`;
  });

  window.addEventListener('admin:ready', () => inbox.load(), { once: true });
</script>
