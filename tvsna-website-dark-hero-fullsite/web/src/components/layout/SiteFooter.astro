---
import Logo from '../brand/Logo.astro';
import { site, footerNav } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="ftr on-dark">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo size={42} onDark={true} />
        <p class="ftr__blurb">
          A volunteer-run, non-profit community of Tamil Nadu Vokkaliga families
          across the United States, Canada and India.
        </p>
        <ul class="ftr__social">
          <li><a href={site.social.facebook} rel="noopener">Facebook group</a></li>
          <li><a href={site.social.whatsapp} rel="noopener">WhatsApp community</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>

      {
        footerNav.map((col) => (
          <nav class="ftr__col" aria-label={col.heading}>
            <h2 class="ftr__heading">{col.heading}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="ftr__bottom">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <ul>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--soil);
    color: var(--text-on-dark);
    padding-block: var(--s-7) var(--s-5);
    margin-top: var(--s-8);
  }

  /*
    Collapses properly. The previous footer was a fixed
    grid-template-columns: 2fr 1fr 1fr 1fr with no media query at all, so at
    320px it rendered four ~66px columns, one word per line.
  */
  .ftr__top {
    display: grid;
    gap: var(--s-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .ftr__top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 62rem) {
    .ftr__top {
      grid-template-columns: 1.6fr repeat(3, 1fr);
      gap: var(--s-7);
    }
  }

  .ftr__blurb {
    margin-top: var(--s-4);
    max-width: 34ch;
    font-size: var(--t-sm);
    color: var(--text-on-dark-muted);
  }

  .ftr__social {
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-sm);
  }

  .ftr__heading {
    font-family: var(--font-sans);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--s-3);
  }

  .ftr__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-sm);
  }

  /*
    Footer links previously had no colour rule anywhere, so they inherited the
    browser default #0000EE on near-black — about 2.3:1, a hard WCAG failure.
  */
  .ftr a {
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .ftr a:hover {
    color: var(--gold);
    text-decoration: underline;
  }

  .ftr__bottom {
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
    justify-content: space-between;
    align-items: center;
    font-size: var(--t-xs);
    color: var(--text-on-dark-muted);
  }

  .ftr__bottom ul {
    list-style: none;
    display: flex;
    gap: var(--s-4);
    padding: 0;
    margin: 0;
  }
</style>
