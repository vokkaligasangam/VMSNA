rules_version = '2';

// VMSNA Firestore security rules.
//
// These rules are the ONLY authorization boundary in the system: the browser
// talks to Firestore directly, so anything permitted here is permitted to any
// signed-in user with devtools open. Changes must be covered by tests/rules.
//
// Admin identity is an email allowlist today; it moves to custom claims in a
// later phase. Keep this list in sync with ADMIN_EMAILS in functions/src/index.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'vikramkanagaraj@gmail.com',
        'vokkaligasangam@gmail.com',
        'sureshgowder@gmail.com',
        'deeppak.kambarayar@gmail.com',
        'krishnakumarmuthian@gmail.com',
        'muru100@gmail.com',
        'vanithavijay@gmail.com',
        'raghuraja@gmail.com',
        'jegan.thiru@gmail.com',
        'skparamasivam@gmail.com',
        'drnandeesh@hotmail.com',
        'poornisaran@gmail.com',
        'sivasrees@gmail.com',
        'thirumudi@gmail.com'
      ];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Fields an applicant may edit on their own record. status, adminNotified,
    // approvedBy/At and rejectedBy/At are deliberately absent: without this
    // restriction a pending member could simply write status = 'approved'
    // and grant themselves access to the member directory.
    function selfEditable() {
      return [
        'name', 'phone', 'street', 'city', 'state', 'zip',
        'nativePlaceSelf', 'nativePlaceSpouse',
        'profession', 'profileUrl',
        'spouseName', 'spouseEmail', 'spousePhone',
        'spouseProfession', 'spouseProfileUrl',
        'childrenDetails', 'privacyLevel', 'updatedAt'
      ];
    }

    function adminEditable() {
      return [
        'status', 'adminNotified', 'adminNotes',
        'approvedAt', 'approvedBy',
        'rejectedAt', 'rejectedBy', 'rejectionReason',
        'updatedAt'
      ];
    }

    match /membershipApplications/{docId} {
      // A new application always starts pending and is owned by its creator.
      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending';

      // Own record, or admin, or an approved record.
      //
      // The third disjunct is what makes the member directory's
      // where('status','==','approved') query provable, and therefore legal.
      // Without it Firestore rejects the whole query and the directory is
      // empty for every non-admin.
      //
      // REMAINING GAP: this still lets a signed-in member read every field of
      // every approved record directly from the API, so a member who chose a
      // limited profile is only protected by the client-side projection in
      // dashboard.html. Closing this properly requires the server-written
      // directory/{uid} projection, which is Phase 2 — it cannot be fixed here
      // without breaking the live directory.
      allow read: if (signedIn() && isOwner(resource.data.userId))
                  || isAdmin()
                  || (signedIn() && resource.data.status == 'approved');

      // Members may edit their own profile fields only; admins may change the
      // review fields only. Neither can touch the other's.
      allow update: if (isOwner(resource.data.userId) && onlyChanged(selfEditable()))
                    || (isAdmin() && onlyChanged(adminEditable()));

      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Legacy collection: rules existed but no code ever read or wrote it.
    match /members/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Welfare requests. Anyone may submit one without signing in, but the
    // contents are education, medical and employment hardship disclosures —
    // the most sensitive data the organisation holds. Admin-only to read.
    // Nothing is deletable: retention is a policy decision, not a UI button.
    match /helpRequests/{docId} {
      allow create: if validHelpRequest();
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyChanged(['status', 'assignedTo', 'notes', 'acknowledgedAt']);
      allow delete: if false;
    }

    function validHelpRequest() {
      return request.resource.data.keys().hasAll(['name', 'email', 'requestType', 'status'])
             && request.resource.data.status == 'pending'
             && request.resource.data.requestType in ['Education', 'Medical', 'Employment', 'Other Services', 'General']
             && request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 120
             && request.resource.data.email is string
             && request.resource.data.email.size() <= 200
             && request.resource.data.keys().size() <= 14;
    }

    match /contactMessages/{docId} {
      allow create: if validContactMessage();
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyChanged(['status', 'assignedTo', 'notes']);
      allow delete: if false;
    }

    function validContactMessage() {
      return request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'status'])
             && request.resource.data.status == 'unread'
             && request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 120
             && request.resource.data.email is string
             && request.resource.data.email.size() <= 200
             && request.resource.data.subject.size() <= 200
             && request.resource.data.message is string
             && request.resource.data.message.size() <= 5000
             && request.resource.data.keys().size() <= 8;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
